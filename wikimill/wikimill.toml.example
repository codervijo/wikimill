# wikimill policy — copy to wikimill.toml and edit.
#
# This file holds POLICY: what the tool looks for. Credentials and environment
# live in wikimill.env — a secret does not belong in a checked-in config file.
#
# Precedence, highest first:  CLI flag > environment > wikimill.toml > default.
# Every value below is shown at its built-in default; delete what you do not
# want to override. Run `wikimill config validate` after editing — an unknown
# key is an error, never silently ignored.
#
# NOT configurable, deliberately: per-domain concurrency of 1, redirect and
# body-size caps, robots.txt obedience, and the two-resolver rule for
# `unregistered`. Those protect other people and the integrity of results;
# configurable politeness is politeness you will eventually turn off.
#
# Editing anything under [scoring], [classify], [markers], [enrich] or [check]
# changes the recorded classifier version automatically, so verdicts stay
# attributable to the rules that produced them.

# How candidates are ranked. Policy defaults, not measured values.
[scoring]
# citation_points_per_page = 3
# citation_points_cap = 30
# dead_link_tagged_points = 5
# private_suffix_penalty = -15

# [scoring.state_points]
#   unregistered = 50
#   expiring = 35
#   for_sale = 30
#   parked = 20
#   no_rdap_for_tld = 5
#   unknown = 3
#   active = 0

# [scoring.url_death_points]
#   dns_failure = 6
#   unregistered = 6
#   for_sale = 5
#   parked = 4
#   tls_failure = 3
#   soft_404 = 2
#   hard_404 = 2

# [scoring.kind_points]
#   citation = 8
#   external_links_section = 5
#   further_reading = 4

# What counts as a candidate worth exporting.
[export]
# candidate_states = ["unregistered", "expiring", "for_sale", "parked", "no_rdap_for_tld"]
# min_pages = 1

# Which states are worth paying to extract Wikipedia context for.
[enrich]
# url_trigger_states = ["dns_failure", "for_sale", "hard_404", "parked", "soft_404", "tls_failure", "unregistered"]
# domain_trigger_states = ["expiring", "for_sale", "parked", "unregistered"]

# Which domains earn an authoritative DNS+RDAP check, and how often.
[check]
# interesting_url_states = ["dns_failure", "tls_failure", "hard_404", "soft_404", "parked", "for_sale"]
# expiry_watch_days = 60
# rdap_concurrency_per_registry = 4

# [check.recheck_days]
#   unregistered = 3
#   expiring = 1
#   for_sale = 7
#   parked = 7
#   active = 90
#   no_rdap_for_tld = 30
#   unknown = 7

# URL verdicts and their recheck cadences.
[classify]
# hard_404_confirmations = 3
# default_recheck_seconds = 2592000
# thin_body_bytes = 512
#
# Two states escalate on repeat instead of using a flat cadence (§12).
# hard_404 doubles per repeat up to this ceiling — 180 days:
# hard_404_backoff_cap_seconds = 15552000
# temporarily_unavailable doubles from 1h; once doubling would pass the cap it
# stops escalating and re-queues at the weekly interval, rather than knocking
# on an unhealthy host every day forever:
# transient_cap_seconds = 86400
# transient_requeue_seconds = 604800

# [classify.recheck_seconds]
#   unregistered = 259200
#   for_sale = 604800
#   parked = 604800
#   dns_failure = 604800
#   tls_failure = 1209600
#   soft_404 = 2592000
#   hard_404 = 2592000
#   live = 7776000
#   redirect = 7776000
#   temporarily_unavailable = 3600
#   blocked_by_robots = 15552000

# Vocabularies for content classification. These drift as parking providers change templates.
[markers]
# parking_providers = ["sedoparking.com", "sedo.com/search/", "parkingcrew.net", "bodis.com", "parklogic.com", "above.com/park", "voodoo.com", "dan.com", "afternic.com", "hugedomains.com", "namebright.com", "undeveloped.com", "parked-content.godaddy.com", "sav.com/park", "domainparkingserver", "cashparking.com"]
# parking_phrases = ["this domain is parked", "this domain name is parked", "parked free, courtesy of", "domain parking service", "this webpage was generated by the domain owner", "the domain has been registered", "this page is provided courtesy of"]
# parking_weak = ["related searches", "sponsored listings", "related links", "search ads"]
# for_sale_phrases = ["this domain is for sale", "this domain name is for sale", "buy this domain", "purchase this domain", "the domain name is for sale", "domain is available for purchase", "inquire about this domain", "make an offer on this domain", "interested in this domain", "this domain may be for sale"]
# soft_404_phrases = ["page not found", "page cannot be found", "page could not be found", "page doesn't exist", "page does not exist", "the requested url was not found", "no longer available", "this page has moved", "404 error", "error 404", "http 404", "file not found", "sorry, we couldn't find", "sorry, this page", "we can't find the page", "content not found", "nothing found"]
# soft_404_title_markers = ["404", "not found", "page missing", "page unavailable", "page removed"]

# Throughput and pacing. Does not affect verdicts.
[crawl]
# concurrency = 8
# delay_seconds = 1.0
# max_retries = 3
# retry_base_seconds = 2.0
# retry_cap_seconds = 60.0
# circuit_breaker_threshold = 5
